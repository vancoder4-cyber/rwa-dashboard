# Neon pooled connection used lazily by Vercel Functions.
DATABASE_URL=

# Neon direct/unpooled connection preferred by `npm run db:migrate`.
DATABASE_URL_UNPOOLED=

# Private Vercel Blob write token. Never expose it to browser code.
BLOB_READ_WRITE_TOKEN=

# Safe rollout defaults: no PostgreSQL mutation and no normalized-catalog object upload.
PG_WRITE_MODE=off
RAW_ARCHIVE_MODE=off
