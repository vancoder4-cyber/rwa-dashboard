{
  "crons": [
    { "path": "/api/listing-audit-cron", "schedule": "45 0 * * *" },
    { "path": "/api/health", "schedule": "0 1 * * *" },
    { "path": "/api/signal-snapshot-cron", "schedule": "7 * * * *" }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
